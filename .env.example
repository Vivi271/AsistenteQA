# ==============================
# PRQA — Variables de Entorno (EJEMPLO)
# ==============================
# Copia este archivo como .env y ajusta los valores

# Modelo LLM (debe estar disponible en Ollama)
# Opciones: llama3.1:8b, llama3.2:3b, mistral:7b, qwen2.5:7b
LLM_MODEL=llama3.2:3b

# Host de Ollama (no cambiar si usas Docker Compose)
OLLAMA_HOST=http://ollama:11434

# Rutas internas del contenedor (no cambiar)
CHROMA_PATH=/app/chroma_db
KNOWLEDGE_BASE_PATH=/app/knowledge_base

# ── Base de datos MySQL ─────────────────────────────────────
# Estas variables son usadas por el servicio mysql y la app
MYSQL_ROOT_PASSWORD=cambia_esto_por_tu_password
MYSQL_DATABASE=prqa_db
MYSQL_USER=prqa_user
MYSQL_PASSWORD=cambia_esto_por_tu_password

# URL de conexión MySQL (generada automáticamente con las variables anteriores)
DB_URL=mysql+pymysql://prqa_user:cambia_esto_por_tu_password@mysql:3306/prqa_db?charset=utf8mb4

# Nombre de la empresa (para personalizar la UI)
COMPANY_NAME=Ciel Ingeniería S.A.S
